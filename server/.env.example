PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cyber_awareness
JWT_SECRET=replace_with_a_long_random_development_secret
JWT_EXPIRES_IN=1d
AI_SERVICE_URL=http://localhost:8000
AI_USE_ML_MODEL=true
CLIENT_URL=http://localhost:5173
# Use the URL employees can reach; localhost is suitable only for a local demo.
APP_BASE_URL=http://localhost:5173
# Used only by the explicit `npm run bootstrap-admin` command or local demo seed.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_password

# Optional. Assignment notices are sent only to domains listed in the allowlist.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_ALLOWED_RECIPIENT_DOMAINS=
